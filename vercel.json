{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/data.js": {
      "maxDuration": 30,
      "regions": ["fra1"]
    },
    "api/firms-situation.js": {
      "maxDuration": 30,
      "regions": ["fra1"]
    },
    "api/live-reports.js": {
      "maxDuration": 30,
      "regions": ["fra1"]
    },
    "api/live-situation.js": {
      "maxDuration": 30,
      "regions": ["fra1"]
    },
    "api/sentinel-quicklook.js": {
      "maxDuration": 30,
      "regions": ["fra1"]
    },
    "api/refresh.js": {
      "maxDuration": 60,
      "regions": ["fra1"]
    },
    "api/refresh-queue.js": {
      "maxDuration": 60,
      "regions": ["fra1"],
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "venn-fire-refresh",
          "retryAfterSeconds": 60,
          "initialDelaySeconds": 0
        }
      ]
    },
    "api/ingest-controlled.js": {
      "maxDuration": 60,
      "regions": ["fra1"]
    }
  },
  "crons": [
    {
      "path": "/api/refresh",
      "schedule": "11 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    }
  ]
}
